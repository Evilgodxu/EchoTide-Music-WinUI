<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YiChao.Screens.Home.Expanded.ExpandedAssembly"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bar="using:YiChao.Screens.Home.Component.Bar"
    xmlns:playlist="using:YiChao.Screens.Home.Component.Playlist"
    xmlns:player="using:YiChao.Screens.Home.Component.Player">

    <Grid x:Name="RootArea">
        <!-- 双栏主体：左封面视觉区、右歌词区，各占一半，左右居中 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="CoverZone"
                Padding="24,0,12,0"
                SizeChanged="OnCoverZoneSizeChanged">
                <player:CoverBlend
                    x:Name="Cover"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                x:Name="LyricsZone"
                Grid.Column="1"
                Padding="12">
                <player:LyricsPanel
                    x:Name="Lyrics"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </Grid>

        <!-- 全屏点击检测：点在封面外的任意位置切换标题栏与控制栏显隐 -->
        <Grid x:Name="TapLayer" Background="Transparent" />

        <!-- 播放模式展开期间的点击遮罩：压在控制栏之下，其余位置的点击先收起模式选择 -->
        <Grid
            x:Name="ModeScrim"
            Background="Transparent"
            Tapped="OnModeScrimTapped"
            Visibility="Collapsed" />

        <!-- 悬浮标题栏与控制栏：默认不可见，由指针靠近边缘或点击唤出，点击唤出的停两秒后收起 -->
        <Grid
            x:Name="TopBarHost"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TopBarOffset" />
            </Grid.RenderTransform>
            <bar:HomeTopBar x:Name="TopBar" />
        </Grid>

        <Grid
            x:Name="ControlsHost"
            Padding="0,0,0,16"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ControlsOffset" />
            </Grid.RenderTransform>
            <!-- 控制栏铺满窗口宽度：两端各钉一枚按钮，中间那组自己居中 -->
            <StackPanel>
                <!-- 音频信息条：格式 · 位深/采样率 · 比特率。信息未就绪时留空，控制栏不随其显隐跳动 -->
                <TextBlock
                    x:Name="FormatInfo"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Foreground="White"
                    Opacity="0.6" />
                <player:PlayerControls x:Name="Controls" />
            </StackPanel>
        </Grid>

        <!-- 窗口底边的播放进度：细到不抢视线，随底部控制区一起显隐。
             填充条整幅铺开、只按占比做横向缩放——改宽度会每帧触发一次重排，缩放只走合成 -->
        <Grid
            x:Name="ProgressHost"
            Height="2"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0">
            <Rectangle Fill="#26FFFFFF" />
            <Rectangle
                x:Name="ProgressFill"
                Fill="#D9FFFFFF"
                RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!-- 播放列表面板：唯一压在控制栏之上的浮层，打开时整屏归它 -->
        <playlist:PlaylistPanel x:Name="Playlist" />
    </Grid>
</UserControl>
