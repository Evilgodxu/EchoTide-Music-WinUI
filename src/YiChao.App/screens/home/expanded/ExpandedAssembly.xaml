<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YiChao.Screens.Home.Expanded.ExpandedAssembly"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bar="using:YiChao.Screens.Home.Component.Bar"
    xmlns:playlist="using:YiChao.Screens.Home.Component.Playlist"
    xmlns:player="using:YiChao.Screens.Home.Component.Player">

    <Grid x:Name="RootArea">
        <!-- 双栏主体：左封面视觉区、右歌词透视区，各占一半，左右居中 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="CoverZone"
                Padding="24,0,12,0"
                SizeChanged="OnCoverZoneSizeChanged">
                <player:CoverBlend
                    x:Name="Cover"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- 透视相机挂在父层，倾角挂在歌词栏自身：WinUI 3 没有 Transform3DGroup，两段变换只能分层给 -->
            <Grid x:Name="LyricsPerspective" Grid.Column="1">
                <Grid
                    x:Name="LyricsZone"
                    Padding="12"
                    SizeChanged="OnLyricsZoneSizeChanged">
                    <player:LyricsPanel
                        x:Name="Lyrics"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 全屏点击检测：点在封面外的任意位置切换标题栏与控制栏显隐 -->
        <Grid x:Name="TapLayer" Background="Transparent" />

        <!-- 播放模式展开期间的点击遮罩：压在控制栏之下，其余位置的点击先收起模式选择 -->
        <Grid
            x:Name="ModeScrim"
            Background="Transparent"
            Tapped="OnModeScrimTapped"
            Visibility="Collapsed" />

        <!-- 悬浮标题栏与控制栏：默认不可见，由指针靠近边缘或点击唤出，点击唤出的停两秒后收起 -->
        <Grid
            x:Name="TopBarHost"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TopBarOffset" />
            </Grid.RenderTransform>
            <bar:HomeTopBar x:Name="TopBar" />
        </Grid>

        <Grid
            x:Name="ControlsHost"
            Padding="0,0,0,16"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ControlsOffset" />
            </Grid.RenderTransform>
            <player:PlayerControls x:Name="Controls" />
        </Grid>

        <!-- 播放列表面板：唯一压在控制栏之上的浮层，打开时整屏归它 -->
        <playlist:PlaylistPanel x:Name="Playlist" />
    </Grid>
</UserControl>
