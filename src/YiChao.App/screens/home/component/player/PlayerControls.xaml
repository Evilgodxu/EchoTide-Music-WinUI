<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YiChao.Screens.Home.Component.Player.PlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:YiChao.Ui.Component">

    <UserControl.Resources>
        <!-- 控制键统一 48 见方、图标 32、圆底透明，与忆潮的 dp 值一致 -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <!--
        底部控制栏：播放模式 → 上一曲 → 播放/暂停 → 下一曲 → 播放列表，整组居中。
        模式按下后图标转半圈变成右向箭头，中间四个键让位给三种模式选项，选中即切换并收起。

        图标数据一律写成绝对坐标：WinUI 的路径解析对「z 之后的相对 m」和「省略命令符的连续坐标」
        处理不可靠，多子路径的图标会因此画歪（上一曲、暂停都踩过）。
    -->
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">

            <Button
                x:Name="ModeButton"
                Click="OnModeClick"
                Style="{StaticResource ControlButtonStyle}"
                ToolTipService.ToolTip="播放模式">
                <Grid
                    Width="32"
                    Height="32"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="ModeRotation" />
                    </Grid.RenderTransform>

                    <!-- 收起态：当前模式的图标 -->
                    <Grid x:Name="ModeGlyph">
                        <ui:MaterialIcon
                            x:Name="ModeRepeatIcon"
                            IconData="M7 7 H17 V10 L21 6 L17 2 V5 H5 V11 H7 Z M17 17 H7 V14 L3 18 L7 22 V19 H19 V13 H17 Z" />
                        <ui:MaterialIcon
                            x:Name="ModeRepeatOneIcon"
                            IconData="M7 7 H17 V10 L21 6 L17 2 V5 H5 V11 H7 Z M17 17 H7 V14 L3 18 L7 22 V19 H19 V13 H17 Z M13 15 V9 H12 L10 10 V11 H11.5 V15 H13 Z"
                            Visibility="Collapsed" />
                        <ui:MaterialIcon
                            x:Name="ModeShuffleIcon"
                            IconData="M10.59 9.17 L5.41 4 L4 5.41 L9.17 10.58 Z M14.5 4 L16.54 6.04 L4 18.59 L5.41 20 L17.96 7.46 L20 9.5 V4 H14.5 Z M14.83 13.41 L13.42 14.82 L16.55 17.95 L14.5 20 H20 V14.5 L17.96 16.54 Z"
                            Visibility="Collapsed" />
                    </Grid>

                    <!-- 展开态：右向箭头，与模式图标交叉淡入淡出 -->
                    <ui:MaterialIcon
                        x:Name="ModeArrowIcon"
                        IconData="M8.59 16.59 L13.17 12 L8.59 7.41 L10 6 L16 12 L10 18 Z"
                        Opacity="0" />
                </Grid>
            </Button>

            <StackPanel
                x:Name="TransportGroup"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    x:Name="PreviousButton"
                    Click="OnPreviousClick"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTipService.ToolTip="上一曲">
                    <ui:MaterialIcon IconData="M6 6 H8 V18 H6 Z M9.5 12 L18 18 V6 Z M16 14.14 L12.97 12 L16 9.86 V14.14 Z" />
                </Button>

                <Button
                    x:Name="PlayPauseButton"
                    Click="OnPlayPauseClick"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTipService.ToolTip="播放">
                    <Grid>
                        <ui:MaterialIcon
                            x:Name="PlayIcon"
                            IconData="M10 8.64 L15.27 12 L10 15.36 V8.64 Z M8 5 V19 L19 12 Z" />
                        <ui:MaterialIcon
                            x:Name="PauseIcon"
                            IconData="M6 19 H10 V5 H6 Z M14 5 V19 H18 V5 Z"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button
                    x:Name="NextButton"
                    Click="OnNextClick"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTipService.ToolTip="下一曲">
                    <ui:MaterialIcon IconData="M6 18 L14.5 12 L6 6 Z M8 9.86 L11.03 12 L8 14.14 V9.86 Z M16 6 H18 V18 H16 Z" />
                </Button>

                <Button
                    x:Name="PlaylistButton"
                    Click="OnPlaylistClick"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTipService.ToolTip="播放列表">
                    <ui:MaterialIcon IconData="M22 6h-5v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6zm-7 0H3v2h12V6zm0 4H3v2h12v-2zm-4 4H3v2h8v-2z" />
                </Button>
            </StackPanel>

            <!-- 展开期间的三种模式选项：当前模式纯白，其余压到 55% 白 -->
            <StackPanel
                x:Name="ModeOptions"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <Button
                    x:Name="RepeatAllOption"
                    Click="OnModeOptionClick"
                    Style="{StaticResource ControlButtonStyle}"
                    Tag="RepeatAll">
                    <ui:MaterialIcon
                        x:Name="RepeatAllOptionIcon"
                        IconData="M7 7 H17 V10 L21 6 L17 2 V5 H5 V11 H7 Z M17 17 H7 V14 L3 18 L7 22 V19 H19 V13 H17 Z" />
                </Button>
                <Button
                    x:Name="RepeatOneOption"
                    Click="OnModeOptionClick"
                    Style="{StaticResource ControlButtonStyle}"
                    Tag="RepeatOne">
                    <ui:MaterialIcon
                        x:Name="RepeatOneOptionIcon"
                        IconData="M7 7 H17 V10 L21 6 L17 2 V5 H5 V11 H7 Z M17 17 H7 V14 L3 18 L7 22 V19 H19 V13 H17 Z M13 15 V9 H12 L10 10 V11 H11.5 V15 H13 Z" />
                </Button>
                <Button
                    x:Name="ShuffleOption"
                    Click="OnModeOptionClick"
                    Style="{StaticResource ControlButtonStyle}"
                    Tag="Shuffle">
                    <ui:MaterialIcon
                        x:Name="ShuffleOptionIcon"
                        IconData="M10.59 9.17 L5.41 4 L4 5.41 L9.17 10.58 Z M14.5 4 L16.54 6.04 L4 18.59 L5.41 20 L17.96 7.46 L20 9.5 V4 H14.5 Z M14.83 13.41 L13.42 14.82 L16.55 17.95 L14.5 20 H20 V14.5 L17.96 16.54 Z" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
