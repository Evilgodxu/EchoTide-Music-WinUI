<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YiChao.Screens.Home.Component.Player.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 歌词视口：高度随面板尺寸变化，内容在其中整体平移；行溢出经裁剪与上下边缘渐隐处理 -->
    <Grid x:Name="Viewport">
        <StackPanel x:Name="LinesHost" VerticalAlignment="Top">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ContentOffset" />
            </StackPanel.RenderTransform>
        </StackPanel>
        <TextBlock
            x:Name="EmptyHint"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="#B8FFFFFF"
            Text="暂无歌词"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
