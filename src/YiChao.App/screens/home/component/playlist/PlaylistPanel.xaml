<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YiChao.Screens.Home.Component.Playlist.PlaylistPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:playlist="using:YiChao.Screens.Home.Component.Playlist"
    xmlns:ui="using:YiChao.Ui.Component">

    <!--
        播放列表面板：横屏下占据整个窗口自下方升起，与忆潮横屏的列表页同形。
        收起走右键（面板内任意位置）或 Esc，不设返回按钮。
        面板底色固定为深色——这一片压在封面衍生背景之上，与主题无关。
    -->
    <Grid x:Name="RootLayer" Visibility="Collapsed">
        <Grid
            x:Name="Backdrop"
            Background="#59000000"
            Opacity="0"
            Tapped="OnBackdropTapped" />

        <Grid
            x:Name="Panel"
            Background="#F20D1117"
            Opacity="0"
            RequestedTheme="Dark">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelOffset" Y="48" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Margin="24,20,24,8"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <TextBlock
                    x:Name="CountText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#8CFFFFFF" />
            </StackPanel>

            <ListView
                x:Name="TrackList"
                Grid.Row="1"
                Padding="8,0,8,16"
                IsItemClickEnabled="True"
                ItemClick="OnTrackItemClick"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="playlist:PlaylistRow">
                        <Grid
                            Padding="10,7"
                            Background="{x:Bind RowBackground, Mode=OneWay}"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 行内封面：取不到时留一块浅底占位；当前曲目盖暗底并叠播放标记 -->
                            <Border
                                Width="36"
                                Height="36"
                                Background="#1FFFFFFF"
                                CornerRadius="6">
                                <Grid>
                                    <Image
                                        Source="{x:Bind Cover, Mode=OneWay}"
                                        Stretch="UniformToFill" />
                                    <Grid Background="#80000000" Visibility="{x:Bind CurrentOverlayVisibility, Mode=OneWay}">
                                        <ui:MaterialIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IconData="M10 20 H14 V4 H10 Z M4 20 H8 V12 H4 Z M16 9 V20 H20 V9 Z"
                                            IconSize="16" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="White"
                                    MaxLines="1"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#8CFFFFFF"
                                    MaxLines="1"
                                    Text="{x:Bind Artist}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#66FFFFFF"
                                Text="{x:Bind DurationText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#8CFFFFFF"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
