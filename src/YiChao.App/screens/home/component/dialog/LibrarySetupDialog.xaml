<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YiChao.Screens.Home.Component.Dialog.LibrarySetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary">

    <StackPanel
        x:Name="Body"
        Width="420"
        Spacing="12">
        <TextBlock
            x:Name="Hint"
            FontSize="13"
            TextWrapping="Wrap" />

        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FolderList" />
        </ScrollViewer>

        <TextBlock
            x:Name="EmptyHint"
            FontSize="12" />

        <Button
            x:Name="AddButton"
            HorizontalAlignment="Left"
            Click="OnAddClick" />
    </StackPanel>
</ContentDialog>
