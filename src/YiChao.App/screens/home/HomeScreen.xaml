<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YiChao.Screens.Home.HomeScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:background="using:YiChao.Screens.Home.Component.Background"
    xmlns:expanded="using:YiChao.Screens.Home.Expanded"
    xmlns:settings="using:YiChao.Screens.Settings"
    xmlns:window="using:YiChao.Ui.Component.Window"
    PointerExited="OnRootPointerExited"
    PointerMoved="OnRootPointerMoved">

    <!-- 首页骨架：沉浸背景铺满全屏，其上叠形态组装器与设置页，最上层是标题拖拽条与窗口按钮 -->
    <Grid x:Name="Root">
        <background:SongImmersiveBackground x:Name="Backdrop" />
        <expanded:ExpandedAssembly x:Name="Assembly" />

        <Grid
            x:Name="EmptyLayer"
            Background="#0D1117CC"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="White"
                    Text="曲库为空" />
                <HyperlinkButton
                    x:Name="ChooseFolderButton"
                    HorizontalAlignment="Center"
                    Click="OnChooseFolderClick"
                    Content="选择音乐文件夹" />
            </StackPanel>
        </Grid>

        <settings:SettingsScreen x:Name="SettingsPage" Visibility="Collapsed" />

        <!-- 沉浸标题栏的拖拽区：贯穿顶部的一条薄带，压在内容之上，浮层收起后窗口仍可拖动 -->
        <Grid
            x:Name="TitleBarDragArea"
            Height="32"
            VerticalAlignment="Top"
            Background="Transparent" />

        <!-- 右上角：设置入口在左，三枚窗口按钮在右，整体随标题栏浮层显隐 -->
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Button
                x:Name="SettingsButton"
                Width="40"
                AutomationProperties.Name="设置"
                Click="OnSettingsClick"
                Style="{StaticResource CaptionButtonStyle}"
                IsHitTestVisible="False"
                Opacity="0"
                ToolTipService.ToolTip="设置">
                <Path
                    Width="16"
                    Height="16"
                    Data="M19.43 12.98c.04-.32.07-.64.07-.98 0-.34-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46a.5.5 0 0 0-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65A.488.488 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1a.566.566 0 0 0-.18-.03c-.17 0-.34.09-.43.25l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98 0 .33.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46a.5.5 0 0 0 .61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.06.02.12.03.18.03.17 0 .34-.09.43-.25l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zm-1.98-1.71c.04.31.05.52.05.73 0 .21-.02.43-.05.73l-.14 1.13.89.7 1.08.84-.7 1.21-1.27-.51-1.04-.42-.9.68c-.43.32-.84.56-1.25.73l-1.06.43-.16 1.13-.2 1.35h-1.4l-.19-1.35-.16-1.13-1.06-.43c-.43-.18-.83-.41-1.23-.71l-.91-.7-1.06.43-1.27.51-.7-1.21 1.08-.84.89-.7-.14-1.13c-.03-.31-.05-.54-.05-.74s.02-.43.05-.73l.14-1.13-.89-.7-1.08-.84.7-1.21 1.27.51 1.04.42.9-.68c.43-.32.84-.56 1.25-.73l1.06-.43.16-1.13.2-1.35h1.39l.19 1.35.16 1.13 1.06.43c.43.18.83.41 1.23.71l.91.7 1.06-.43 1.27-.51.7 1.21-1.07.85-.89.7.14 1.13zM12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 6c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                    Fill="White"
                    Stretch="Uniform" />
            </Button>

            <!-- 窗口按钮压在拖拽区之上，随标题栏浮层一起显隐 -->
            <window:CaptionButtons
                x:Name="Caption"
                IsHitTestVisible="False"
                Opacity="0" />
        </StackPanel>
    </Grid>
</UserControl>
